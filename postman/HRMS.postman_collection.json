    ,{"name":"Audit logs (read-only, admin)","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/api/audit-logs?limit=100&offset=0","host":["{{baseUrl}}"],"path":["api","audit-logs"],"query":[{"key":"limit","value":"100"},{"key":"offset","value":"0"}]}}}
    ,{"name":"Attendance report PDF","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/api/reports/attendance.pdf?start_date=2026-10-01&end_date=2026-10-31","host":["{{baseUrl}}"],"path":["api","reports","attendance.pdf"],"query":[{"key":"start_date","value":"2026-10-01"},{"key":"end_date","value":"2026-10-31"}]}}}
  ]
